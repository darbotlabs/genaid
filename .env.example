# GenAID Environment Configuration
# Copy this file to .env and configure your settings

# ============================================================================
# Azure Foundry / Azure OpenAI Configuration
# ============================================================================

# Azure OpenAI API Key and Endpoint
# Get from: https://portal.azure.com -> Your OpenAI Resource -> Keys and Endpoint
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Azure Management API (for listing models)
# Required for automatic model discovery
AZURE_OPENAI_SUBSCRIPTION_ID=your-subscription-id
AZURE_OPENAI_RESOURCE_GROUP=your-resource-group
AZURE_OPENAI_API_MODELS_TYPE=openai

# Azure AI Inference / Foundry Endpoints
# For Azure AI Studio / Foundry serverless deployments
AZURE_AI_INFERENCE_API_KEY=your-inference-key
AZURE_AI_INFERENCE_ENDPOINT=https://your-inference-endpoint.inference.ai.azure.com

# Azure Serverless Models
AZURE_SERVERLESS_MODELS_API_KEY=your-serverless-key
AZURE_SERVERLESS_MODELS_ENDPOINT=https://your-serverless-endpoint.models.ai.azure.com

# ============================================================================
# Azure Authentication Method (MSAL / Azure CLI)
# ============================================================================
# Options:
#   - cli:              Azure CLI (az login) - Default, recommended for local dev
#   - env:              Environment variables (service principal)
#   - powershell:       Azure PowerShell
#   - devcli:           Azure Developer CLI (azd)
#   - managedidentity:  Azure Managed Identity (for VMs/containers)
#   - workloadidentity: Workload Identity (for Kubernetes)
#   - default:          DefaultAzureCredential chain (tries all methods)
AZURE_CREDENTIALS_TYPE=cli

# For service principal authentication (when using AZURE_CREDENTIALS_TYPE=env)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# ============================================================================
# GitHub Models / Copilot CLI Configuration
# ============================================================================

# GitHub Personal Access Token
# Get from: https://github.com/settings/tokens
# Scopes needed: repo, read:user
GITHUB_TOKEN=ghp_your_github_token

# GitHub Models API (uses Azure backend)
# Same token as GITHUB_TOKEN
GITHUB_MODELS_API_KEY=ghp_your_github_token

# ============================================================================
# OpenWebUI Configuration
# ============================================================================
# OpenWebUI typically runs on port 8080
# If using Docker Desktop, use host.docker.internal
OPENWEBUI_API_BASE=http://localhost:8080
OPENWEBUI_API_KEY=your-openwebui-api-key

# ============================================================================
# LiteLLM Configuration
# ============================================================================
# LiteLLM proxy typically runs on port 4000
# Provides OpenAI-compatible API for multiple providers
LITELLM_API_BASE=http://localhost:4000
LITELLM_API_KEY=your-litellm-key

# ============================================================================
# OpenAI Configuration (Fallback)
# ============================================================================
OPENAI_API_KEY=sk-your-openai-key

# ============================================================================
# Other LLM Providers
# ============================================================================

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Ollama (local models)
OLLAMA_HOST=http://localhost:11434

# Mistral AI
MISTRAL_API_KEY=your-mistral-key

# Google AI
GOOGLE_API_KEY=your-google-api-key

# ============================================================================
# GenAID Configuration
# ============================================================================

# Default model to use
# Examples:
#   - azure:gpt-4o
#   - github:gpt-4o
#   - openai:gpt-4o-mini
#   - ollama:phi3
#   - litellm:gpt-4
GENAID_DEFAULT_MODEL=azure:gpt-4o

# Workspace directory
GENAID_WORKSPACE=/workspace

# Enable debug logging
DEBUG=genaid:*
