{
    "name": "genaid-vscode",
    "publisher": "genaid",
    "homepage": "https://darbotlabs.github.io/genaid/",
    "author": {
        "name": "DarbotLabs"
    },
    "displayName": "GenAID",
    "description": "Generative AI Scripting.",
    "version": "1.135.0",
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.98.0"
    },
    "keywords": [
        "javascript",
        "typescript",
        "genaid",
        "genai",
        "openai",
        "chatgpt",
        "gpt4",
        "ai",
        "copilot",
        "scripting",
        "python",
        "llm",
        "gpt",
        "mcp"
    ],
    "categories": [
        "AI",
        "Programming Languages",
        "Machine Learning",
        "Education",
        "Notebooks",
        "Other"
    ],
    "license": "MIT",
    "extensionKind": [
        "workspace"
    ],
    "npm": {
        "publish": false
    },
    "activationEvents": [
        "workspaceContains:*.genai.{js,mjs,mts}",
        "workspaceContains:**/*.genai.{js,mjs,mts}",
        "onNotebook:genaid"
    ],
    "main": "./built/extension.js",
    "bugs": {
        "url": "https://github.com/darbotlabs/genaid/issues"
    },
    "repository": {
        "url": "https://github.com/darbotlabs/genaid"
    },
    "contributes": {
        "chatParticipants": [
            {
                "id": "genaid",
                "description": "Calls the GenAID agent.",
                "name": "genaid",
                "fullName": "GenAID",
                "isSticky": false,
                "commands": [
                    {
                        "name": "list",
                        "description": "Lists all available GenAID scripts.",
                        "isSticky": false,
                        "sampleRequest": "/list"
                    },
                    {
                        "name": "run",
                        "description": "Runs a GenAID script. The query should start with the script filename without the extension.",
                        "isSticky": false,
                        "sampleRequest": "/run poem"
                    },
                    {
                        "name": "models",
                        "description": "Lists available Language Models and the aliases.",
                        "isSticky": false,
                        "sampleRequest": "/models"
                    }
                ]
            }
        ],
        "configurationDefaults": {
            "files.associations": {
                ".gitignore.genai": "ignore",
                ".gitignore.genaid": "ignore"
            }
        },
        "markdown.markdownItPlugins": true,
        "problemMatchers": [
            {
                "name": "genaid",
                "label": "GenAID annotations",
                "source": "Generated by a LLM.",
                "applyTo": "allDocuments",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^\\s*::(info|notice|warning|error)\\s+file=([^,]+),\\s*line=(\\d+)(,\\s*endLine=(\\d+)\\s*)?(,\\s*code=([^,:]+)?\\s*)?::(.*)$",
                    "severity": 1,
                    "file": 2,
                    "line": 3,
                    "code": 7,
                    "message": 8
                }
            }
        ],
        "taskDefinitions": [
            {
                "type": "genaid",
                "required": [
                    "script"
                ],
                "properties": {
                    "script": {
                        "type": "string",
                        "description": "GenAID script to run"
                    }
                }
            }
        ],
        "walkthroughs": [
            {
                "id": "genaid.tutorial",
                "title": "GenAID scripting with GenAID",
                "description": "Use GenAID to create LLM-powered scripts.",
                "steps": [
                    {
                        "id": "genaid.tutirla.node",
                        "title": "Install Node.JS LTS (v20+)",
                        "description": "GenAID requires Node.JS LTS (v20+) to run. [Read more...](https://darbotlabs.github.io/genaid/getting-started/installation/)",
                        "media": {
                            "image": "media/tutorial-start.png",
                            "altText": ""
                        }
                    },
                    {
                        "id": "genaid.tutorial.start",
                        "title": "Open Tutorial Notebook",
                        "description": "You will learn how to create LLM-powered scripts using JavaScript.\nOpen the command palette and select **GenAID: Create Markdown Notebook** to get started.",
                        "media": {
                            "image": "media/tutorial-start.png",
                            "altText": ""
                        },
                        "completionEvents": [
                            "onCommand:genaid.notebook.create"
                        ]
                    }
                ]
            }
        ],
        "notebooks": [
            {
                "type": "genaid",
                "displayName": "GenAID Markdown Notebook",
                "priority": "option",
                "selector": [
                    {
                        "filenamePattern": "*.{md,mdx,markdown}"
                    }
                ]
            }
        ],
        "markdown.previewStyles": [
            "./markdown.css"
        ],
        "icons": {
            "genaid-logo": {
                "description": "GenAID logo",
                "default": {
                    "fontPath": "./media/genaid.woff",
                    "fontCharacter": "\\E000"
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "genaid",
                    "title": "GenAID",
                    "icon": "./icon.svg"
                }
            ]
        },
        "views": {
            "genaid": [
                {
                    "id": "genaid.trace",
                    "name": "Trace",
                    "visibility": "visible",
                    "type": "tree",
                    "icon": "./icon.svg"
                },
                {
                    "id": "genaid.connections",
                    "name": "Connections",
                    "visibility": "collapsed",
                    "type": "tree",
                    "icon": "./icon.svg"
                },
                {
                    "id": "genaid.prompts",
                    "name": "Scripts",
                    "visibility": "collapsed",
                    "type": "tree",
                    "icon": "./icon.svg"
                }
            ]
        },
        "menus": {
            "editor/context": [
                {
                    "command": "genaid.fragment.prompt",
                    "when": "!inDebugMode",
                    "group": "genaid@1"
                },
                {
                    "command": "genaid.fragment.debug",
                    "when": "!inDebugMode",
                    "group": "genaid@2"
                },
                {
                    "command": "genaid.fragment.fix",
                    "when": "!inDebugMode && resourceFilename =~ /.*\\.genai\\.(js|mjs|mts)$/",
                    "group": "genaid@2"
                }
            ],
            "file/newFile": [
                {
                    "command": "genaid.newfile.script"
                }
            ],
            "editor/title/run": [
                {
                    "command": "genaid.fragment.prompt",
                    "when": "!inDebugMode && resourceFilename =~ /.*\\.((genai\\.(js|mjs|mts))|prompty)$/",
                    "group": "genaid@1"
                },
                {
                    "command": "genaid.fragment.debug",
                    "when": "!inDebugMode && resourceFilename =~ /.*\\.genai\\.(js|mjs|mts)$/",
                    "group": "genaid@2"
                },
                {
                    "command": "genaid.server.show",
                    "when": "activeWebviewPanelId == genaid",
                    "group": "genaid@4"
                }
            ],
            "commandPalette": [
                {
                    "command": "genaid.fragment.debug",
                    "when": "false"
                },
                {
                    "command": "genaid.newfile.script",
                    "when": "false"
                },
                {
                    "command": "genaid.prompt.navigate",
                    "when": "false"
                },
                {
                    "command": "genaid.request.open",
                    "when": "false"
                },
                {
                    "command": "genaid.request.status",
                    "when": "false"
                },
                {
                    "command": "genaid.connections.refresh",
                    "when": "false"
                }
            ],
            "view/title": [
                {
                    "command": "genaid.request.abort",
                    "when": "view == genaid.trace",
                    "group": "navigation"
                },
                {
                    "command": "genaid.connections.refresh",
                    "when": "view == genaid.connections",
                    "group": "navigation"
                },
                {
                    "command": "genaid.prompt.create",
                    "when": "view == genaid.prompts",
                    "group": "navigation"
                },
                {
                    "command": "genaid.prompt.refresh",
                    "when": "view == genaid.prompts",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "genaid.prompt.fork",
                    "when": "view == genaid.prompts && viewItem  =~ /^prompt/"
                }
            ],
            "explorer/context": [
                {
                    "command": "genaid.fragment.prompt",
                    "when": "explorerViewletVisible && !inDebugMode && !(resourceFilename =~ /\\.genai\\.(js|mjs|mts|prompty)$/)",
                    "group": "genaid@1"
                }
            ]
        },
        "configuration": [
            {
                "title": "GenAID",
                "properties": {
                    "genaid.localTypeDefinitions": {
                        "type": "boolean",
                        "default": true,
                        "description": "Use local type definitions for GenAID (.genaid.d.ts and tsconfig.json in any project containing *.genai.* files)."
                    },
                    "genaid.githubCopilotInstructions": {
                        "type": "boolean",
                        "default": true,
                        "description": "Add custom instructions.md in .genaid/instructions folder to support GenAID script generation."
                    },
                    "genaid.hideServerTerminal": {
                        "type": "boolean",
                        "default": true,
                        "description": "Hide server terminal from user."
                    },
                    "genaid.languageChatModels": {
                        "type": "object",
                        "description": "Mapping from GenAID model (openai:gpt-4) to Visual Studio Code Language Chat Model (github...)"
                    },
                    "genaid.languageChatModelsProvider": {
                        "type": "boolean",
                        "description": "Use GitHub Copilot Chat Models (or other models provided in Visual Studio Code) as the preferred LLM provider when a model is not specified."
                    },
                    "genaid.diagnostics": {
                        "type": "boolean",
                        "default": false,
                        "description": "Enable developer diagnostic mode. Including opening server terminal and leaving terminals opened."
                    },
                    "genaid.debug": {
                        "type": "string",
                        "default": "script",
                        "description": "List of logging categories that will be set as 'DEBUG' environment variable when launching the GenAID server. If 'diagnostics' is on, it is overriden by '*'."
                    },
                    "genaid.cache": {
                        "type": "boolean",
                        "default": true,
                        "description": "Enable or disables LLM request cache support."
                    },
                    "genaid.cli.version": {
                        "type": "string",
                        "description": "GenAID CLI version to use. Default matches the extension version."
                    },
                    "genaid.cli.path": {
                        "type": "string",
                        "description": "Path to GenAID CLI. Default uses npx."
                    }
                }
            }
        ],
        "commands": [
            {
                "command": "genaid.server.stop",
                "title": "Stop GenAID server",
                "category": "GenAID",
                "icon": "$(close)"
            },
            {
                "command": "genaid.server.start",
                "title": "Start GenAID server",
                "category": "GenAID",
                "icon": "$(server-process)"
            },
            {
                "command": "genaid.server.show",
                "title": "Show GenAID server",
                "category": "GenAID",
                "icon": "$(terminal)"
            },
            {
                "command": "genaid.notebook.create",
                "title": "Create GenAID Markdown Notebook",
                "category": "GenAID"
            },
            {
                "command": "genaid.request.abort",
                "title": "Abort OpenAI request",
                "category": "GenAID",
                "icon": "$(debug-stop)"
            },
            {
                "command": "genaid.fragment.prompt",
                "title": "Run GenAID...",
                "category": "GenAID",
                "icon": "$(genaid-logo)"
            },
            {
                "command": "genaid.fragment.debug",
                "title": "Debug GenAID...",
                "category": "GenAID",
                "icon": "$(debug)"
            },
            {
                "command": "genaid.fragment.fix",
                "title": "Fix GenAID Types",
                "category": "GenAID",
                "icon": "$(lightbulb-autofix)"
            },
            {
                "command": "genaid.prompt.navigate",
                "title": "Navigate to script",
                "category": "GenAID"
            },
            {
                "command": "genaid.prompt.create",
                "title": "Create new script...",
                "icon": "$(add)",
                "category": "GenAID"
            },
            {
                "command": "genaid.prompt.refresh",
                "title": "Refresh script list",
                "icon": "$(refresh)",
                "category": "GenAID"
            },
            {
                "command": "genaid.newfile.script",
                "title": "GenAID File",
                "category": "GenAID"
            },
            {
                "command": "genaid.prompt.fork",
                "title": "Fork GenAID...",
                "category": "GenAID",
                "icon": "$(repo-forked)"
            },
            {
                "command": "genaid.request.open",
                "title": "Open request or response",
                "category": "GenAID"
            },
            {
                "command": "genaid.request.open.view",
                "title": "View request",
                "category": "GenAID"
            },
            {
                "command": "genaid.request.open.trace",
                "title": "Open Trace",
                "category": "GenAID"
            },
            {
                "command": "genaid.request.open.output",
                "title": "Open Output",
                "category": "GenAID"
            },
            {
                "command": "genaid.request.status",
                "title": "Show information message about OpenAI request status",
                "category": "GenAID"
            },
            {
                "command": "genaid.connections.refresh",
                "title": "Refresh",
                "category": "GenAID",
                "icon": "$(refresh)"
            }
        ]
    },
    "scripts": {
        "vscode:update-dts": "npx @vscode/dts dev && mv vscode.*.d.ts src/",
        "vscode:prepublish": "yarn run compile",
        "compile:icons": "node updatefonts.mjs",
        "compile:extension": "node build.mjs",
        "compile": "yarn compile:extension",
        "vis:treemap": "npx --yes esbuild-visualizer --metadata esbuild.meta.json --filename esbuild.treemap.html",
        "vis:network": "npx --yes esbuild-visualizer --metadata esbuild.meta.json --filename esbuild.network.html --template network",
        "vis:sunburst": "npx --yes esbuild-visualizer --metadata esbuild.meta.json --filename esbuild.sunburst.html --template sunburst",
        "lint": "eslint src --ext ts",
        "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ../sample",
        "typecheck": "tsc -p .",
        "prepackage": "zx prepackage.mjs",
        "postpackage": "zx postpackage.mjs",
        "package": "vsce package --dependencies --out genaid.vsix --yarn",
        "generate-manifest": "vsce generate-manifest -i genaid.vsix -o genaid.manifest"
    },
    "devDependencies": {
        "@types/markdown-it": "^14.1.2",
        "@types/vscode": "^1.98.0",
        "@vscode/vsce": "^3.3.2",
        "assert": "^2.1.0",
        "es-toolkit": "^1.37.2",
        "markdown-it": "^14.1.0",
        "markdown-it-github-alerts": "0.2.0",
        "process": "^0.11.10",
        "typescript": "5.8.3",
        "vscode-uri": "^3.1.0",
        "websocket-polyfill": "0.0.3",
        "zx": "^8.5.3"
    }
}
